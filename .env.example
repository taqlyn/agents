# Taqlyn control-plane API (local compose or hosted).
# From a container use host.docker.internal instead of 127.0.0.1.
TAQLYN_API_URL=http://host.docker.internal:8080

# Optional bootstrap. Prefer `auth_login` so the password is not in env.
# TAQLYN_EMAIL=
# TAQLYN_PASSWORD=

# Optional: reuse an existing dashboard session instead of password login.
# TAQLYN_SESSION_TOKEN=

# Default scopes when logging in via env bootstrap. Overridable by auth_login / auth_set_scope.
# environment: sandbox | production | both
TAQLYN_ENV=sandbox
# permission: read | write
TAQLYN_PERMISSION=write

# stdio (Cursor/Claude subprocess) or http (Docker / future remote).
TAQLYN_MCP_TRANSPORT=stdio

# HTTP bind. Used when TAQLYN_MCP_TRANSPORT=http.
TAQLYN_MCP_ADDR=:8787

# Override token file (default: $XDG_CONFIG_HOME/taqlyn/mcp.json).
# TAQLYN_TOKEN_PATH=
