# Live Taqlyn control plane only (HTTPS). Localhost is rejected by the MCP.
TAQLYN_API_URL=https://api.rutvik.qzz.io

# Optional bootstrap. Prefer `auth_login` so the password is not in env.
# TAQLYN_EMAIL=
# TAQLYN_PASSWORD=

# Optional: reuse an existing dashboard session instead of password login.
# TAQLYN_SESSION_TOKEN=

# environment: sandbox | production | both
TAQLYN_ENV=sandbox
# permission: read | write
TAQLYN_PERMISSION=write

TAQLYN_MCP_TRANSPORT=stdio
TAQLYN_MCP_ADDR=:8787
