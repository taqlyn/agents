{
  "mcpServers": {
    "taqlyn": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e", "TAQLYN_MCP_TRANSPORT=stdio",
        "-e", "TAQLYN_WORKSPACE=/workspace",
        "-e", "TAQLYN_API_URL=https://api.rutvik.qzz.io",
        "-v", "taqlyn-mcp-config:/home/mcp/.config/taqlyn",
        "-v", "${workspaceFolder}:/workspace:ro",
        "ghcr.io/taqlyn/agents:latest"
      ]
    }
  }
}
